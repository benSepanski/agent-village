{
  "name": "agent-village",
  "private": true,
  "version": "0.0.0",
  "description": "Personal multi-tenant scheduler for autonomous AI agents.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm run lint:root",
    "lint:root": "eslint . --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "synth": "turbo run synth",
    "dev": "turbo run dev --parallel",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json,md,yml,yaml}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json,md,yml,yaml}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "deps:check": "depcruise packages tools --config .dependency-cruiser.cjs",
    "local:up": "docker compose up -d && pnpm bootstrap:local",
    "local:down": "docker compose down",
    "local:reset": "docker compose down -v && rm -rf .localstack .dynamodb-data",
    "bootstrap:local": "tsx tools/scripts/local-bootstrap.ts",
    "doctor:local": "tsx tools/scripts/local-doctor.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "devDependencies": {
    "@agent-village/eslint-plugin": "workspace:*",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "dependency-cruiser": "^16.10.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.5.0",
    "typescript": "^5.8.2",
    "vitest": "^4.1.0",
    "@vitest/coverage-v8": "^2.1.8",
    "@playwright/test": "^1.49.1"
  }
}
