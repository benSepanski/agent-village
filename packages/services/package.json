    "@agent-village/domain": "workspace:*",
    "@agent-village/data": "workspace:*",
    "@aws-sdk/client-ecs": "^3.700.0",
    "@aws-sdk/client-scheduler": "^3.700.0",
    "@aws-sdk/client-sts": "^3.700.0",
    "@anthropic-ai/sdk": "^0.36.0"
  }
